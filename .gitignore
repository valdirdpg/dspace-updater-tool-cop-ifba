/tmp/*
/dspace-install-dir/*
/postgres/*
/dump-postgres/dump.sql
/execution.log
/source/*
/upgrade-variables.properties
/install-variables.properties
/local.cfg
/ibict_upgrade-variables.properties
/dspace-base

# Arquivos .env com dados sensiveis (senha de e-mail, etc.)
# Inclui o ./.env da raiz (fonte canonica) e o dspace-install-dir/config/.env (gerado).
# Os modelos .env.EXAMPLE permanecem versionados.
.env
**/.env
!.env.EXAMPLE
!**/.env.EXAMPLE

# mail.env e gerado pelo build a partir do .env (contem credenciais de e-mail). Nao versionar.
mail.env
**/mail.env

# Codigo-fonte do DSpace baixado/extraido (nao versionar; e clonado/baixado pelo build).
/DSpace-dspace-7.6/

# Diretorio de instalacao padrao IBICT usado em testes (nao versionar),
# EXCETO os XMLs de configuracao de submissao que ficam versionados.
/default-ibict/*
!/default-ibict/config/
/default-ibict/config/*
!/default-ibict/config/item-submission.xml
!/default-ibict/config/submission-forms.xml

# Assetstore: apenas modelo de teste, nao deve ser versionado (em qualquer local).
assetstore/
**/assetstore/

# Variaveis locais/ambiente (copias e backups que nao vao para o repositorio).
/upgrade-variables.properties__old
/upgrade-variables.properties_para _o_servidor
