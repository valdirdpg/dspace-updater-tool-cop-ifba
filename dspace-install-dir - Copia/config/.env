# =========================================================
# DSpace 7 - Email settings (.env) - FONTE CANONICA (raiz do projeto)
# =========================================================
# PT_BR: Este e o .env "fonte da verdade", assim como o ./local.cfg da raiz.
#        Durante o build/upgrade (backend_build.sh), este arquivo e copiado
#        para dspace-install-dir/config/.env, que e o caminho lido pelo
#        "env_file" dos docker-compose. O DSpace resolve os ${...} do
#        local.cfg a partir destas variaveis de ambiente.
#
#        As chaves usam underscore no lugar do ponto: a propriedade
#        "mail.server.password" -> variavel "mail_server_password".
#
# ATENCAO: NAO versione este arquivo (contem senha). Ja esta no .gitignore.
#
# IMPORTANTE: coloque AQUI SOMENTE variaveis de e-mail (mail_*).
#   NUNCA adicione db.password, db.url, dspace.server.url ou dspace.ui.url.
#   O env_file do docker-compose injeta TODAS as linhas deste arquivo como
#   variaveis de ambiente, e o DSpace prioriza o ambiente sobre o local.cfg.
#   Se voce colocar db.password aqui, ele sobrescreve a senha correta do
#   banco (gerada pelo build) e o backend falha com "password authentication
#   failed" (erro 500 no frontend). As configs de banco sao geradas
#   automaticamente pelo backend_build.sh no local.cfg, nao aqui.
# =========================================================

# SMTP mail server
mail_server=smtp.gmail.com

# SMTP mail server authentication username and password
mail_server_username=publicacoes@ifba.edu.br
mail_server_password=COLOQUE_AQUI_A_SENHA_APP_DO_GMAIL

# SMTP mail server port (defaults to 25)
mail_server_port=587

# From address for mail
mail_from_address=repositorio@ifba.edu.br

# Feedback recipient (limited to one recipient)
feedback_recipient=repositorio@ifba.edu.br

# General site administration (Webmaster) e-mail
mail_admin=repositorio@ifba.edu.br

# Recipient for server errors and alerts
alert_recipient=

# Recipient for new user registration emails
registration_notify=repositorio@ifba.edu.br

# Default mail character set
mail_charset=UTF-8
