# =========================================================
# DSpace 7 - Email settings (.env.EXAMPLE) - FONTE CANONICA (raiz do projeto)
# =========================================================
# PT_BR: Modelo seguro para versionar. Copie para .env e preencha:
#   cp .env.EXAMPLE .env
#
# Durante o build/upgrade, o ./.env e copiado para
# dspace-install-dir/config/.env (caminho lido pelo env_file dos compose).
#
# As chaves seguem a convencao do DSpace: os pontos das propriedades
# viram underscores. Ex.: a propriedade "mail.server.password"
# corresponde a variavel de ambiente "mail_server_password".
# =========================================================

# SMTP mail server
mail_server=smtp.example.com

# SMTP mail server authentication username and password
mail_server_username=usuario@example.com
mail_server_password=change-me

# SMTP mail server port (defaults to 25)
mail_server_port=587

# From address for mail
mail_from_address=dspace-noreply@example.com

# Feedback recipient (limited to one recipient)
feedback_recipient=dspace-help@example.com

# General site administration (Webmaster) e-mail
mail_admin=dspace-help@example.com

# Recipient for server errors and alerts
alert_recipient=

# Recipient for new user registration emails
registration_notify=dspace-help@example.com

# Default mail character set
mail_charset=UTF-8
